# .gitignore - Ignorar archivos comunes para proyectos Node.js

# Node modules
node_modules/
.pnp/
.pnp.js

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul, nyc
coverage/
.nyc_output/

# nyc test coverage
coverage-summary.json

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (deprecated)
bower_components/

# Compiled output
dist/
build/
tmp/
temp/
out/

# Next.js build / cache
.next/
.cache/

# Nuxt.js
.nuxt/
dist/

# Gatsby
.cache/
public/

# Parcel cache
.cache/
.parcel-cache/

# TypeScript
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Svelte
__sapper__/
public/build/

# MacOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Environment variables
.env
.env.*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# dotenv environment variable file example (keep in repo)
!.env.example

# Secrets
*.pem
*.key
*.crt

# Yarn Integrity file
.yarn-integrity

# Yarn v2/v3 cache & releases
.yarn/*
!.yarn/releases
!.yarn/plugins
!.yarn/patches
!.yarn/sdks
!.yarn/versions

# lockfiles (usually committed) - do not ignore by default
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Temporary files
*.swp
*~
.project
.localhistory/

# Docker
docker-compose.override.yml

# Misc
coverage/
reports/